@@ -2556,3 +2556,16 @@ kdp_rwlck_find_owner(__unused struct waitq * waitq, event64_t event, thread_wait
 	waitinfo->context = VM_KERNEL_UNSLIDE_OR_PERM(rwlck);
 	waitinfo->owner = 0;
 }
+
+/*
+ * Build-toolchain compatibility: clang 10 lowers the 4-byte relaxed atomic load in ordered_load() (on the lock word)
+ * to a libcall, where the older clang that Apple used inlined it. On x86 an aligned 4-byte load is atomic, so provide the
+ * helper here; this also stops libclang_rt.cc_kext's spinlock-based __atomic_load_4 (needing OSSpinLockLock) from being linked.
+ */
+uint32_t __atomic_load_4(const volatile void *ptr, int memorder);
+uint32_t
+__atomic_load_4(const volatile void *ptr, int memorder)
+{
+	(void)memorder;
+	return *(const volatile uint32_t *)ptr;
+}
